# Copy this file to .env  (Windows: copy .env.example .env   ·   Mac/Linux: cp .env.example .env)
# Free Groq key, no credit card: https://console.groq.com/keys  ->  paste it in BOTH places marked gsk_your_key_here

# ---------- 1. The model that powers the agent (all three versions) ----------
# Option A (default): Groq's free cloud. Nothing to install.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b

# Option B: Ollama on your laptop (works offline)  ->  ollama pull qwen3:4b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:4b

# Option C: LM Studio on your laptop (start its local server first)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3-4b

# ---------- 2. The AI judge (Part 2) ----------
# The same free Groq key as above
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=gsk_your_key_here
JUDGE_MODEL=openai/gpt-oss-120b
# Optional: increase these if a free judge API returns transient 429 errors
# DEEPEVAL_RETRY_MAX_ATTEMPTS=6
# DEEPEVAL_RETRY_CAP_SECONDS=10

# Backup judge: Cerebras free tier (https://cloud.cerebras.ai)
# JUDGE_BASE_URL=https://api.cerebras.ai/v1
# JUDGE_API_KEY=csk_your_key_here
# JUDGE_MODEL=gpt-oss-120b

# ---------- 3. LangSmith: see every agent step as a trace (step 3) ----------
# Free account + API key: https://smith.langchain.com/settings   Then set LANGSMITH_TRACING=true.
# Tracing uploads prompts, model replies, policy text and agent state to LangSmith (made-up shop data only).
# Nothing in the workshop depends on it: with false, everything still runs locally.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=shopkart-agent-workshop
# If your API key belongs to more than one workspace, also set:
# LANGSMITH_WORKSPACE_ID=your_workspace_id

# In case groq does not work for you then try this 
# https://ollama.com/dashboard 

# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=gpt-oss:20b

# JUDGE_BASE_URL=https://ollama.com/v1
# JUDGE_API_KEY=your_key_here
# JUDGE_MODEL=gpt-oss:20b

# ---------- 4. DeepEval (steps 4 and 5): no usage data, and patient retries on the free tier ----------
DEEPEVAL_TELEMETRY_OPT_OUT=YES
DEEPEVAL_RETRY_MAX_ATTEMPTS=6
DEEPEVAL_RETRY_CAP_SECONDS=10
